# ==========================================================================
#  Backup24/7 — ignore rules
#
#  Rule of thumb: nothing generated, nothing machine-local, and above all
#  nothing containing a credential. Every secret this app needs is read from
#  the environment (see .env.example) — none of it belongs in the repo.
# ==========================================================================

# --- dependencies ---------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- build output ---------------------------------------------------------
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# --- caches ---------------------------------------------------------------
.turbo
.swc
.eslintcache
.cache
*.tmp

# --- test / coverage ------------------------------------------------------
/coverage
/playwright-report
/test-results
/blob-report
/.nyc_output

# --- secrets and local config --------------------------------------------
# Broad by design: every .env variant is ignored, and only the committed
# template is allowed back in. Order matters — the negation must follow the
# pattern it re-includes.
.env
.env.*
!.env.example
*.local

# credentials and keys, whatever they are named
*.pem
*.key
*.p12
*.pfx
*.jks
*-service-account*.json
gcp-*.json
credentials.json
secrets.json

# --- hosting --------------------------------------------------------------
.vercel
.netlify
.amplify
.serverless

# --- logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- editors and OS ------------------------------------------------------
.idea
*.iml
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code: share the workspace recommendations, keep personal settings out.
.vscode/*
!.vscode/extensions.json

# --- agent tooling --------------------------------------------------------
# CLAUDE.md and AGENTS.md are committed on purpose — they are project docs.
# Machine-local agent state is not.
.claude/settings.local.json
.claude/launch.json

# --- working scratch ------------------------------------------------------
# Ad-hoc inspection files (recordings, frame dumps, throwaway HTML) have been
# dropped in /public more than once during development. They are never part of
# the site.
/public/_*
/scratch
/tmp
