# ==========================================================================
#  Backup24/7 — environment template
#
#  Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is
#  the only env file that is ever committed, and it must never carry a real
#  value.
#
#  Every variable below is server-side only. None is prefixed NEXT_PUBLIC_,
#  which means none is exposed to the browser — that is deliberate. Anything
#  named NEXT_PUBLIC_* is inlined into the client bundle and is readable by
#  anyone, so no credential may ever use that prefix.
#
#  All of these are optional. With none set, POST /api/lead still validates the
#  submission and logs the full enquiry server-side rather than dropping it, so
#  a misconfigured deploy loses no leads. See PLACEHOLDERS.md §2.1.
# ==========================================================================

# --- lead delivery: email (step 2) ---------------------------------------
# Team inbox that receives each enquiry. Comma-separate for several.
LEAD_INBOX=
# Transactional mail endpoint — SES, Resend, Postmark or an internal relay.
MAIL_API_URL=
# Sent as `Authorization: Bearer <key>`. A credential; never commit it.
MAIL_API_KEY=
# Envelope sender. Defaults to website@backup247.in when unset.
LEAD_FROM=

# --- lead delivery: Google Sheet (step 3) --------------------------------
# Append endpoint (Apps Script web app, or a service that proxies the Sheets
# API). The service-account credential stays on that service — it must never
# reach this repo or the browser.
SHEET_APPEND_URL=
# Sent as `Authorization: Bearer <token>`. A credential.
SHEET_TOKEN=

# --- lead delivery: CRM webhook (step 4) ---------------------------------
# The CRM-agnostic hand-off. Receives the full lead as JSON, so whichever CRM
# is live — the current one or its replacement — subscribes here without the
# site changing.
LEAD_WEBHOOK_URL=
# Sent as `Authorization: Bearer <token>`. A credential.
LEAD_WEBHOOK_TOKEN=
